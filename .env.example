# Environment
NODE_ENV=development
PORT=3000

# Database Docker Variables
POSTGRES_USER=binger_user
POSTGRES_PASSWORD=binger_pass
POSTGRES_DB=binger_db
POSTGRES_PORT=5432

# Database (PostgreSQL via Supabase or Docker local)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate strong random strings for production)
ACCESS_TOKEN_SECRET=dev-access-secret-change-me-in-production
REFRESH_TOKEN_SECRET=dev-refresh-secret-change-me-in-production
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# CORS
CORS_ORIGIN=http://localhost:8081

# TVmaze
API_URL_SERIES=http://api-series-example

# Gemini
GEMINI_API_KEY=example-api-key-gemini
GEMINI_MODEL=example-model-gemini

# Internal Communication Secret
INTERNAL_SECRET=dev-internal-secret-token-change-me

# SMTP Mail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soporte@tuapp.com
SMTP_PASS=your_gmail_app_password

